# --------------------------------------------------------------------------
# PASOE WebHandler route mapping  (EXAMPLE -- merge into the instance's
# conf/openedge.properties under your ABL application's [<app>.ROOT.WEB]
# section; do NOT commit the live instance file).
#
# Maps the contract paths to the ClearVue.Connector WebHandler classes.
# The base path (clearvue/erp/v1) comes from the PASOE web transport / web
# app context root; these handlers map the path *within* that web app.
#
# 11.6 note: handler routing is the URI -> handler map. Each line is
#   <order>:<URI template>:<handler class>
# Adjust ordinals so they do not collide with existing handlers.
# --------------------------------------------------------------------------

[<instance>.<app>.ROOT.WEB]
# /health  (contract: security:[] -- no auth)
handler1=/health:ClearVue.Connector.Web.HealthWebHandler

# /product-structure?part=&site=&correlationId=
handler2=/product-structure:ClearVue.Connector.Web.ProductStructureWebHandler

# --- session-activate hook: persistent per-session DB connection ---
[<instance>.<app>.ROOT.APSV]
srvrActivateProc=ClearVue/Connector/Data/SessionActivate.p

# --- PROPATH must include the compiled connector root (src/pasoe) ---
# [<instance>.<app>.APSV]
# PROPATH=$CATALINA_BASE/openedge,/opt/clearvue/connector/src/pasoe,...
