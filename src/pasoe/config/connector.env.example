# --------------------------------------------------------------------------
# Connector runtime configuration -- EXAMPLE.
# Copy to the PASOE service environment (systemd unit Environment=, the
# instance's catalina env, or an OS secret store). NEVER commit real values.
# Read by ClearVue.Connector.Config.ConnectorConfig via OS-GETENV.
# --------------------------------------------------------------------------

# The QAD/MFG-PRO domain THIS connector instance serves (legacy hard-coded "MPI").
CLEARVUE_ERP_DOMAIN=MPI

# Logical DB name (matches -ld in the .pf).
CLEARVUE_DB_LOGICAL_NAME=qaddb

# CONNECT parameters -- prefer a -pf reference to the gitignored live .pf.
CLEARVUE_DB_CONNECT_PARAMS=-pf /etc/clearvue/qaddb.pf.local

# Enforced bearer secret. NO DEFAULT -- if unset the connector denies all
# lookups (fail closed). Set from your secret store; never store in source.
CLEARVUE_CONNECTOR_API_KEY=__set_from_secret_store__

# Reconnect tuning (timeout ladder; resilience-and-errors.md). Optional.
CLEARVUE_RECONNECT_MAX_ATTEMPTS=3
CLEARVUE_RECONNECT_BACKOFF_MS=750
CLEARVUE_RECONNECT_CEILING_MS=6000

# SOL-119, optional: site-pinned ADDITIONS to the connection-state error
# classification table (ClearVue.Connector.Web.ErrorClassifier). Comma-separated
# `oeErrNum=CONTRACT_CODE` pairs; CONTRACT_CODE is ERP_DISCONNECTED or
# ERP_UNAVAILABLE (both -> HTTP 503, retryable). Use this to pin a code
# observed on THIS site's broker restart / login failure without a rebuild,
# then fold it into the base table. Example:
# CLEARVUE_CONNECTION_STATE_ERROR_CODES=562=ERP_DISCONNECTED,2624=ERP_UNAVAILABLE
